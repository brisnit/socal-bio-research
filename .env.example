# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables. Never commit real values.

# Public base URL (used for canonical URLs and admin invite links)
NEXT_PUBLIC_SITE_URL=https://socalbioresearch.org

# --- Supabase (client-owned project) --------------------------------------
# Project Settings → API. The anon key is safe to expose (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server-only; bypasses RLS. Used by API routes and the admin.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dr. Peptide (Claude API) ---------------------------------------------
# SECRET. console.anthropic.com → API Keys. Without it, the chat replies
# "Dr. Peptide is offline right now" and points people to the contact form.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
DR_PEPTIDE_MODEL=

# --- Optional: email notifications for new inquiries/registrations ---------
# SECRET. resend.com API key, plus a verified sender address.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# Random string used to hash visitor IPs before storage (privacy).
IP_HASH_SALT=change-me-to-a-long-random-string
